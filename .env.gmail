# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Gmail API Configuration
GMAIL_CLIENT_ID=your-gmail-client-id.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/inventory/email-tracking/oauth/callback/

# Pub/Sub Configuration
PUBSUB_TOPIC_NAME=gmail-webhook-topic
PUBSUB_SUBSCRIPTION_NAME=gmail-webhook-subscription
PUBSUB_WEBHOOK_URL=https://your-domain.com/api/inventory/email-tracking/webhook/pubsub/

# Gmail Webhook Configuration
GMAIL_WEBHOOK_SECRET=your-webhook-secret-key-here
