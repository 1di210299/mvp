# Configuración de la aplicación
APP_ENV=development # development, testing, production
DEBUG=True
SECRET_KEY=your_secret_key_here

# Configuración de la base de datos
DATABASE_URL=sqlite:///whatsapp_sales.db
# Para PostgreSQL: postgresql://user:password@localhost/dbname

# Configuración de Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Configuración de OpenAI
OPENAI_API_KEY=your_openai_api_key

# Configuración de APIs de pago
# Culqi
CULQI_PUBLIC_KEY=your_culqi_public_key
CULQI_PRIVATE_KEY=your_culqi_private_key

# Niubiz
NIUBIZ_MERCHANT_ID=your_niubiz_merchant_id
NIUBIZ_API_KEY=your_niubiz_api_key

# Izipay
IZIPAY_SHOP_ID=your_izipay_shop_id
IZIPAY_CLIENT_ID=your_izipay_client_id
IZIPAY_CLIENT_SECRET=your_izipay_client_secret

# Yape
YAPE_MERCHANT_ID=your_yape_merchant_id
YAPE_API_KEY=your_yape_api_key

# Configuración de seguridad
HONEYPOT_ENABLED=True
REPORTING_EMAIL=alertas@tuempresa.com

# Límites y umbrales
MAX_LOGIN_ATTEMPTS=5
MESSAGE_RATE_LIMIT=100  # Mensajes por hora
SUSPICIOUS_ACTIVITY_THRESHOLD=0.75  # 0-1, donde 1 es alta probabilidad de actividad sospechosa

# Rutas de archivos
LOG_FILE_PATH=logs/app.log
BLACKLIST_FILE=static/data/blacklist.csv
SUSPICIOUS_WORDS_FILE=app/data/suspicious_words.json