# Configuración de la aplicación
DEBUG=True
SECRET_KEY=django-insecure-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de datos
DATABASE_URL=sqlite:///db.sqlite3

# OpenAI API Key (REQUERIDO para funcionalidad de IA)
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_api_key_aqui

# Configuración del servidor
PORT=8000
HOST=0.0.0.0

# Configuración de ML (opcional)
MLFLOW_TRACKING_URI=./mlflow
MLFLOW_EXPERIMENT_NAME=datalens_forecasting

# Email (para notificaciones - opcional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password

# Destinatarios de prueba
TEST_EMAIL_RECIPIENT=destinatario@gmail.com

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TEST_WHATSAPP_TO=whatsapp:+1234567890

# WhatsApp Business API
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_id
TEST_WHATSAPP_RECIPIENT=1234567890

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Configuración de archivos estáticos (producción)
STATIC_ROOT=./staticfiles
MEDIA_ROOT=./media

# Configuración de cache (opcional)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Configuración de Celery (para tareas asíncronas - opcional)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
