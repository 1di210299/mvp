{
    "channel_preference": "whatsapp_only",
    "priority": "high",
    "use_ai_personalization": true,
    "custom_message_template": "¡Hola! Tu pedido #{order_id} ha sido confirmado. Total: ${total}. ¡Gracias por confiar en nosotros!",
