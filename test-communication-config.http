{
    "configurations": [
        {
            "event_type": "payment_failed",
            "channel_preference": "both_email_primary",
            "priority": "urgent",
            "use_ai_personalization": true,
            "custom_message_template": "❌ Problema con tu pago. Por favor contactanos al +51999123456",
            "send_immediately": true,
            "max_retries": 5,
            "fallback_channel": "whatsapp_only"
        },
        {
            "event_type": "promotional",
