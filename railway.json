{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "gunicorn datalens_backend.wsgi:application --bind 0.0.0.0:8080 --timeout 120 --workers 1 --max-requests 1000 --preload",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "production": {
      "variables": {
        "DEBUG": "False",
        "DJANGO_SETTINGS_MODULE": "datalens_backend.settings"
      }
    }
  }
}